diff --git a/user/test_scheduler.c b/user/test_scheduler.c
new file mode 100644
index 0000000..67adf64
--- /dev/null
+++ b/user/test_scheduler.c
@@ -0,0 +1,26 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int main(int argc, char* argv[]) {
+  // Check if ticket count argument is provided
+  if(argc != 2){
+    printf("Usage: test_scheduler <tickets>\n");
+    exit(1);
+  }
+  
+  // Get ticket count from command line argument
+  int tickets = atoi(argv[1]);
+  
+  // Call settickets to set ticket count
+  if(settickets(tickets) < 0){
+    printf("Error: settickets failed\n");
+    exit(1);
+  }
+  
+  // Spin in an infinite loop to keep the process alive
+  while(1) {
+    // Busy wait - process stays RUNNABLE
+  }
+  
+  exit(0);
+}
